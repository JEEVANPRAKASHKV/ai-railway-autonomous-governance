# =============================================================================
# AI Railway Governance Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The platform works WITHOUT any keys (fallback/rule-based mode activates auto).
# =============================================================================

# --- Sarvam AI (primary LLM — Indian model, OpenAI-compatible) ---
# Key from https://dashboard.sarvam.ai → API keys. sarvam-105b costs ₹15 / ₹60 per 1M input / output tokens;
# a support answer is roughly ₹0.03–0.05. Reasoning is switched off by the router for speed and cost.
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_MODEL=sarvam-105b
# SARVAM_BASE_URL=https://api.sarvam.ai   (only change for a proxy / gateway)

# --- LLM routing & spend control ---
# Providers are tried in this order (only those with keys); the rule-based engine is always the last resort.
LLM_PROVIDER_ORDER=sarvam,gemini,azure_openai
# Paid providers pause for the rest of the day once this much (₹) has been spent; 0 = no cap.
LLM_DAILY_BUDGET_INR=50

# --- Google Gemini (failover after Sarvam — free tier at aistudio.google.com) ---
# Get your free key instantly: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# gemini-1.5 / 2.0 are retired; the router also tries gemini-3.1-flash-lite and gemini-3.8-flash automatically
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Azure OpenAI (Optional Alternative) ---
# If Gemini and Azure are both left blank or invalid, the platform automatically
# activates its intelligent rule-based fallback engine — no crash, full functionality.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Security (role-based access for governance actions) ---
# Unset = development keys (fine locally, NOT for a shared deployment).
RB_OPERATOR_KEY=change-me-operator-key
RB_ADMIN_KEY=change-me-admin-key
RB_ALLOWED_ORIGINS=http://localhost:8501
RB_RATE_LIMIT_PER_MIN=120
# Where the tamper-evident audit trail is stored (SQLite)
RB_STATE_DIR=./runtime

# --- Platform Configuration ---
RANDOM_SEED=42
LOG_LEVEL=INFO

# --- Governance Thresholds ---
GOVERNANCE_ALERT_THRESHOLD_P95_LATENCY_MS=3000
GOVERNANCE_DRIFT_PSI_THRESHOLD=0.15
GOVERNANCE_ACCURACY_MIN_THRESHOLD=0.80
GOVERNANCE_HALLUCINATION_THRESHOLD=0.65
GOVERNANCE_BIAS_DIR_THRESHOLD=0.80
GOVERNANCE_FRAUD_FP_RATE_THRESHOLD=0.12

# --- Server Ports ---
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
