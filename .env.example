# =============================================================================
# AI Railway Governance Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The platform works WITHOUT any keys (fallback/rule-based mode activates auto).
# =============================================================================

# --- Azure OpenAI (Optional — enables LLM-powered features) ---
# If these are left blank or the file is absent, the platform uses its
# intelligent rule-based fallback engine — no crash, full functionality.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Platform Configuration ---
RANDOM_SEED=42
LOG_LEVEL=INFO

# --- Governance Thresholds ---
GOVERNANCE_ALERT_THRESHOLD_P95_LATENCY_MS=3000
GOVERNANCE_DRIFT_PSI_THRESHOLD=0.15
GOVERNANCE_ACCURACY_MIN_THRESHOLD=0.80
GOVERNANCE_HALLUCINATION_THRESHOLD=0.65
GOVERNANCE_BIAS_DIR_THRESHOLD=0.80
GOVERNANCE_FRAUD_FP_RATE_THRESHOLD=0.12

# --- Server Ports ---
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
