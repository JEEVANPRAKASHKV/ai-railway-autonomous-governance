# =============================================================================
# .gitignore — AI Railway Autonomous Governance Platform
# Enterprise Monorepo Clean Architecture Standard
# =============================================================================

# --- Environment & Secret Configuration ---
.env
*.env
!.env.example

# --- Python Bytecode & Runtime Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing, Linting & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# --- Operating System Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*.ipynb

# --- Application Specific Data (Deterministic & Reproducible via Scripts) ---
data/raw/
!data/raw/.gitkeep
data/baseline_distributions.pkl
data/*.pkl

# --- Pre-Trained ML Artifacts (Reproducible via models/train_all_models.py) ---
models/artifacts/
!models/artifacts/.gitkeep
!models/registry/model_registry.json

# --- Local Vector Database & Databases ---
chroma_db/
*.sqlite
*.sqlite3
*.db

# --- Runtime Logs ---
logs/
*.log
