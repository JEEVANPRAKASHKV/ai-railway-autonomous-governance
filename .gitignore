# =============================================================================
# .gitignore — AI Railway Autonomous Governance Platform
# Enterprise Monorepo Clean Architecture Standard
# =============================================================================

# --- Environment & Secret Configuration ---
.env
*.env
!.env.example

# --- Python Bytecode & Runtime Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing, Linting & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# --- Operating System Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*.ipynb

# --- Application Specific Data (Deterministic & Reproducible via Scripts) ---
# Raw data & baselines included for instant deployment & evaluator reproducibility
# data/raw/
data/*.pkl
!data/baseline_distributions.pkl

# --- Pre-Trained ML Artifacts (Reproducible via models/train_all_models.py) ---
# Pre-trained artifacts included for zero-cold-start cloud deployment
# models/artifacts/
!models/artifacts/*.pkl
!models/artifacts/*.json
!models/artifacts/shap_explainers/*.pkl
!models/registry/model_registry.json

# --- Local Vector Database & Databases ---
chroma_db/
*.sqlite
*.sqlite3
*.db

# --- Runtime Logs & Generated Reports ---
logs/
*.log
governance/reports/RPT-*

# runtime state produced by autonomous retraining
models/artifacts/challengers/
models/registry/lifecycle_state.json

# local scratch
_to_delete/

# durable governance state (audit trail, lifecycle) — created at runtime
runtime/
